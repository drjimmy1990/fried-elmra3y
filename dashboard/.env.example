# ==============================================================================
# Supabase Cloud Credentials (REQUIRED)
# Found in: Supabase Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY is server-only (never exposed to the browser). It is
# required for /channels (Meta apps + page tokens) and team management.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# OPTIONAL
# Facebook pages, Meta App ID/Secret and page tokens are managed from the
# dashboard at /dashboard/channels -- nothing Facebook-related goes here.
# ==============================================================================

# Public base URL of this dashboard (used to build the Facebook OAuth redirect
# URI). Set it in production / behind proxies, e.g. https://dash.example.com
# If empty, the URL is derived from the incoming request.
APP_BASE_URL=

# Graph API version used by the dashboard (default: v23.0).
META_GRAPH_VERSION=
