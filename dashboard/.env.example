# ==============================================================================
# Supabase Cloud Credentials (REQUIRED)
# Found in: Supabase Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# Dynamic Integrations (OPTIONAL in .env.local)
# NOTE: You can now configure Facebook Page ID, Page Access Token, 
# Telegram Bot Token, and Telegram Chat ID directly from the Dashboard UI 
# at /dashboard/settings without editing this file!
# ==============================================================================
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
