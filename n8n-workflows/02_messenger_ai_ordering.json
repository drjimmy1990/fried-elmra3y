        "jsonBody": "={\n  \"recipient\": { \"id\": \"{{ $('Parse Messenger Event').item.json.sender_id }}\" },\n  \"message\": {\n    \"attachment\": {\n      \"type\": \"template\",\n      \"payload\": {\n        \"template_type\": \"generic\",\n        \"elements\": [\n          {\n            \"title\": \"منيو مشويات وساندوتشات الخديوي 👑🍖\",\n            \"subtitle\": \"تصفح قائمتنا الكاملة واطلب وجبتك المفضلة فوراً!\",\n            \"image_url\": \"https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800\",\n            \"buttons\": [\n              {\n                \"type\": \"postback\",\n                \"title\": \"مشويات ملكية 🥩\",\n                \"payload\": \"CATEGORY_GRILLS\"\n              },\n              {\n                \"type\": \"postback\",\n                \"title\": \"ساندوتشات سريعة 🥪\",\n                \"payload\": \"CATEGORY_SANDWICHES\"\n              },\n              {\n                \"type\": \"postback\",\n                \"title\": \"اطلب مع المساعد 🤖\",\n                \"payload\": \"START_ORDER\"\n              }\n            ]\n          }\n        ]\n      }\n    }\n  }\n}",
