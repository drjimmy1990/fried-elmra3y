    {
      "parameters": {
        "jsCode": "// Parse incoming Messenger message or postback payload\nconst body = $input.first().json.body || $input.first().json;\n\n// Handle Webhook verification challenge if forwarded\nif ($input.first().json.query && $input.first().json.query['hub.challenge']) {\n  return [{ json: { challenge: $input.first().json.query['hub.challenge'], is_challenge: true } }];\n}\n\nconst entry = body.entry?.[0];\nconst messaging = entry?.messaging?.[0];\n\nif (!messaging) {\n  return [];\n}\n\nconst senderId = messaging.sender?.id;\nconst recipientId = messaging.recipient?.id;\n\n// Ignore echo messages sent by the page\nif (messaging.message?.is_echo || !senderId) {\n  return [];\n}\n\nconst text = messaging.message?.text || '';\nconst quickReplyPayload = messaging.message?.quick_reply?.payload;\nconst postbackPayload = messaging.postback?.payload;\nconst payload = quickReplyPayload || postbackPayload || null;\nconst attachments = messaging.message?.attachments || [];\n\nreturn [{\n  json: {\n    is_challenge: false,\n    sender_id: senderId,\n    recipient_id: recipientId,\n    text: text.trim(),\n    payload: payload,\n    has_attachments: attachments.length > 0,\n    attachments: attachments,\n    timestamp: messaging.timestamp || Date.now()\n  }\n}];"
      },
