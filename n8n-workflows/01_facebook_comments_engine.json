      "parameters": {
        "jsCode": "// Global rule reply generator\nconst globalRule = $input.first().json;\nconst commentData = $('Parse Comment Event').first().json;\n\nconst replies = globalRule.comment_replies || ['أهلاً بحضرتك! تم الرد في الخاص بكل التفاصيل 📩❤️'];\nconst selectedReply = replies[Math.floor(Math.random() * replies.length)];\n\nreturn [{\n  json: {\n    comment_id: commentData.comment_id,\n    post_id: commentData.post_id,\n    commenter_id: commentData.commenter_id,\n    commenter_name: commentData.commenter_name,\n    public_reply: selectedReply,\n    auto_like: globalRule.auto_like_comment !== false,\n    send_dm: globalRule.send_dm !== false,\n    dm_message: globalRule.dm_message || 'أهلاً بحضرتك في مطعم الخديوي! كيف نقدر نساعدك اليوم؟ 🌟',\n    dm_buttons: globalRule.dm_buttons || []\n  }\n}];"
      },
