{
  "name": "01 - Facebook Page Comments Auto-Reply & Private DM Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "facebook-comments",
        "responseMode": "onReceived",
        "responseData": "OK",
        "options": {}
      },
      "id": "e81d1111-0001-4000-8000-000000000001",
      "name": "Facebook Feed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        340
      ],
      "webhookId": "facebook-comments-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract incoming Facebook Feed comment payload\nconst body = $input.first().json.body || $input.first().json;\n\n// Handle Webhook verification challenge if forwarded\nif ($input.first().json.query && $input.first().json.query['hub.challenge']) {\n  return [{ json: { challenge: $input.first().json.query['hub.challenge'], is_challenge: true } }];\n}\n\nconst entry = body.entry?.[0];\nconst change = entry?.changes?.[0];\nconst value = change?.value;\n\n// Verify event is an added comment\nif (change?.field !== 'feed' || value?.item !== 'comment' || value?.verb !== 'add') {\n  return [];\n}\n\n// Extract details\nconst postId = value.post_id || value.parent_id;\nconst commentId = value.comment_id;\nconst commenterId = value.from?.id;\nconst commenterName = value.from?.name || 'Customer';\nconst messageText = (value.message || '').trim();\n\n// Ignore empty comments or comments made by the page itself\nif (!commentId || !postId || value.from?.id === entry?.id) {\n  return [];\n}\n\nreturn [{\n  json: {\n    is_challenge: false,\n    post_id: postId,\n    comment_id: commentId,\n    commenter_id: commenterId,\n    commenter_name: commenterName,\n    comment_text: messageText,\n    created_time: value.created_time || Math.floor(Date.now() / 1000)\n  }\n}];"
      },
      "id": "e81d1111-0001-4000-8000-000000000002",
      "name": "Parse Comment Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        340
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "post_rules",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "facebook_post_id",
              "condition": "eq",
              "keyValue": "={{ $json.post_id }}"
            },
            {
              "keyName": "is_active",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "id": "e81d1111-0001-4000-8000-000000000003",
      "name": "Query Specific Post Rule",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        700,
        340
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase Connection"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has_post_rule",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e81d1111-0001-4000-8000-000000000004",
      "name": "Has Specific Rule?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        940,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// Specific rule evaluator: checks match_type (any vs keywords) and picks random reply\nconst rule = $input.first().json;\nconst commentData = $('Parse Comment Event').first().json;\n\nconst matchType = rule.match_type || 'any';\nconst triggerKeywords = rule.trigger_keywords || [];\nconst commentText = (commentData.comment_text || '').toLowerCase();\n\nlet isMatch = false;\nif (matchType === 'any') {\n  isMatch = true;\n} else if (matchType === 'keywords') {\n  if (triggerKeywords.length === 0) {\n    isMatch = true;\n  } else {\n    isMatch = triggerKeywords.some(kw => commentText.includes(kw.trim().toLowerCase()));\n  }\n}\n\nif (!isMatch) {\n  return [];\n}\n\n// Pick random reply from variations to avoid Facebook anti-spam restrictions\nconst replies = rule.comment_replies || ['تم الرد في الخاص يا فندم ❤️'];\nconst selectedReply = replies[Math.floor(Math.random() * replies.length)];\n\nreturn [{\n  json: {\n    rule_id: rule.id,\n    comment_id: commentData.comment_id,\n    post_id: commentData.post_id,\n    commenter_id: commentData.commenter_id,\n    commenter_name: commentData.commenter_name,\n    public_reply: selectedReply,\n    auto_like: rule.auto_like_comment !== false,\n    dm_message: rule.dm_message,\n    dm_image_url: rule.dm_image_url,\n    dm_buttons: rule.dm_buttons || []\n  }\n}];"
      },
      "id": "e81d1111-0001-4000-8000-000000000005",
      "name": "Evaluate Post Rule & Pick Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        220
      ]
    },
