        "url": "=https://graph.facebook.com/v21.0/{{ $json.comment_id }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {{ JSON.stringify($json.public_reply) }}\n}",
        "options": {}
      },
